{
  "name": "tron-city",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test:api": "playwright test --config e2e/playwright.config.ts",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:ui": "playwright test --config ui-tests/playwright.config.ts",
    "test:state": "playwright test --config e2e/playwright.config.ts client-state.spec.ts"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@microsoft/signalr": "10.0.11",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
